# CNT

units           metal
boundary        p p p
atom_style      atomic

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

read_data       data.lmp
mass            1 12


pair_style      deepmd ./CNT_defects.pth
pair_coeff      * * C


# --- 0. 固定原子：受力和速度清零 ---
# 每一端固定的原子数
variable nfix equal N

# 计算右端固定区的起始原子 ID
variable natoms equal atoms
variable istart equal v_natoms-v_nfix+1

# 定义左右固定组
group fixed_left  id 1:${nfix}
group fixed_right id ${istart}:${natoms}
group fixed union fixed_left fixed_right

# 除两端固定原子外，其余原子作为可动散射区
group mobile subtract all fixed

# 固定原子：受力和速度清零
fix freeze fixed setforce 0.0 0.0 0.0
velocity fixed set 0.0 0.0 0.0


# --- 1. 能量最小化 ---
thermo_style custom step pe etotal press fnorm fmax
thermo       10

minimize     1.0e-6 1.0e-8 1000 10000

reset_timestep 0


# --- 2. 热弛豫 MD ---

# 初始化散射区原子速度
velocity mobile create 50.0 23456789 mom yes rot yes dist gaussian

# 再次确保固定原子速度为零
velocity fixed set 0.0 0.0 0.0

# 对散射区进行 NVT 控温
fix 1 mobile nvt temp 50.0 50.0 0.1

# 计算散射区 mobile 组的实际温度
compute Tmobile mobile temp

timestep 0.001


# --- 3. 热力学输出 ---

# c_Tmobile 是实际参与运动和控温的散射区温度
thermo_style custom step c_Tmobile pe etotal press vol
thermo       1000


# --- 4. 轨迹与受力输出 ---

dump 1 all custom 100 traj.dump id type x y z fx fy fz

# 按原子 ID 排序
dump_modify 1 sort id

# 控制输出精度
dump_modify 1 format line "%d %d %.11g %.11g %.11g %.11g %.11g %.11g"


# --- 5. 运行 40 ps ---
run 40000