# CNT

units           metal
boundary        p p p
atom_style      atomic

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

read_data       data.lmp
mass            1 12


pair_style      deepmd ./CNT_defects.pth
pair_coeff      * * C



# --- 0. 固定原子：受力和速度清零 ---
# 每一端固定的原子数
variable nfix equal 240

# 计算右端固定区的起始原子 ID
variable natoms equal atoms
variable istart equal v_natoms-v_nfix+1

# 定义左右固定组
group fixed_left  id 1:${nfix}
group fixed_right id ${istart}:${natoms}
group fixed union fixed_left fixed_right

# 除两端固定原子外，其余原子作为可动散射区
group mobile subtract all fixed

# 固定两端电极原子：受力和速度清零
fix freeze fixed setforce 0.0 0.0 0.0
velocity fixed set 0.0 0.0 0.0
# --- 用左电极中心定义参考轴 ---
compute com_left fixed_left com

variable xc equal c_com_left[1]
variable yc equal c_com_left[2]

# --- 对 mobile 原子施加以电极中心轴为中心的 xy 弹簧 ---
variable K equal 0.01

variable dx atom "x-v_xc"
variable dy atom "y-v_yc"

variable fx atom "-v_K*v_dx"
variable fy atom "-v_K*v_dy"

variable Espring atom "0.5*v_K*(v_dx*v_dx+v_dy*v_dy)"

fix radial mobile addforce v_fx v_fy 0.0 energy v_Espring
fix_modify radial energy yes


# --- 1. 能量最小化 ---
thermo_style custom step pe etotal press fnorm fmax
thermo       10

# 每 10 次优化迭代保存一帧
dump            opt all custom 10 optimization.dump id type x y z
dump_modify     opt sort id
dump_modify     opt format line "%d %d %.15f %.15f %.15f"

min_style       cg
min_modify dmax 0.1 norm max
minimize        0.0 1.0e-3 10000 100000

undump          opt

# 保存最终结构
write_dump all custom optimized.dump id type x y z  modify sort id format line "%d %d %.15f %.15f %.15f"
